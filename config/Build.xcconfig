// Public builds use only bundled PocketTTS assets.
PIPECAT_ENABLE_PHONON = NO
#include? "../.local/BuildOptions.xcconfig"

// Derive every compiler/linker option from the same switch used by packaging.
PIPECAT_PHONON_SWIFT_CONDITION_YES = ENABLE_PHONON
PIPECAT_PHONON_SWIFT_CONDITION_NO =
PIPECAT_PHONON_C_DEFINITION_YES = ENABLE_PHONON=1
PIPECAT_PHONON_C_DEFINITION_NO =
PIPECAT_PHONON_HEADER_PATH_YES = $(SRCROOT)/native/phonon-ffi/include
PIPECAT_PHONON_HEADER_PATH_NO =
PIPECAT_PHONON_LDFLAGS_YES = -lphonon_ffi
PIPECAT_PHONON_LDFLAGS_NO =

PIPECAT_PHONON_SWIFT_CONDITION = $(PIPECAT_PHONON_SWIFT_CONDITION_$(PIPECAT_ENABLE_PHONON))
PIPECAT_PHONON_C_DEFINITION = $(PIPECAT_PHONON_C_DEFINITION_$(PIPECAT_ENABLE_PHONON))
PIPECAT_PHONON_HEADER_PATH = $(PIPECAT_PHONON_HEADER_PATH_$(PIPECAT_ENABLE_PHONON))
PIPECAT_PHONON_LDFLAGS = $(PIPECAT_PHONON_LDFLAGS_$(PIPECAT_ENABLE_PHONON))
